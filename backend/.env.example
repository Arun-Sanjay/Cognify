# ══════════════════════════════════════════════
# Cognify backend environment — copy to .env. Never commit .env.
# ══════════════════════════════════════════════

# ── Database ──
# Local dev: SQLite (RAG uses a Python cosine fallback — no pgvector needed)
DATABASE_URL=sqlite:///./cognify.db
# Production (Supabase project "cognify", Session pooler):
# DATABASE_URL=postgresql+psycopg2://postgres.bqsjstfhldtppgqjdgij:[PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ── Supabase ──
SUPABASE_URL=https://bqsjstfhldtppgqjdgij.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=cognify-documents

# ── Auth ──
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── AI ──
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DEV=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_PROD=claude-opus-4-6
USE_PRODUCTION_MODEL=False
CLAUDE_REQUESTS_PER_MINUTE=20

# ── Speech (optional — browser fallbacks kick in when unset) ──
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
OPENAI_API_KEY=
AUDIO_RETENTION_DAYS=7
AUDIO_CLEANUP_INTERVAL_HOURS=6

# ── CORS ──
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

ENVIRONMENT=development
